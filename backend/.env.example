# Copy to backend/.env (never commit the real file). Everything works without these.
GEMINI_API_KEY=
# HAATHI_EMBEDDER=auto          # auto | bge-m3 | hash
# HAATHI_RERANKER=auto          # auto | bge | lexical
# HAATHI_VECTOR_STORE=qdrant-memory   # or qdrant-server (docker compose up qdrant)
# HAATHI_OLLAMA_URL=http://localhost:11434
# HAATHI_LANGFUSE_ENABLED=false
# Model names change over time; override if Google retires one (list yours at https://aistudio.google.com):
# HAATHI_GEMINI_MODEL=gemini-3.8-flash
# HAATHI_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
