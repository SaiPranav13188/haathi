      "field": "occupation",
      "op": "in",
      "value": [
        "artisan"
      ],
      "source": {
        "doc": "pm_vishwakarma.md",
        "page": 1,
        "quote": "An artisan or craftsperson working in one of the 18 listed family-based trades is eligible."
      }
    },
    {
