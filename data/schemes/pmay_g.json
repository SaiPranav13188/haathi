  "change_note": null,
  "rules": [
    {
      "id": "r1",
      "field": "area",
      "op": "eq",
      "value": "rural",
      "source": {
        "doc": "pmay_g.md",
        "page": 1,
        "quote": "The scheme covers houseless households and households living in kutcha houses in rural areas."
      }
    },
    {
      "id": "r2",
      "field": "owns_pucca_house",
      "op": "eq",
      "value": false,
      "source": {
        "doc": "pmay_g.md",
        "page": 1,
        "quote": "The household must not own a pucca house."
      }
    }
  ],
  "logic": "r1 AND r2",
  "benefit": {
    "summary": {
      "en": "₹1,20,000 (plains) or ₹1,30,000 (hilly areas)",
      "hi": "₹1,20,000 (मैदानी) या ₹1,30,000 (पहाड़ी क्षेत्र)",
      "te": "₹1,20,000 (మైదాన) లేదా ₹1,30,000 (కొండ ప్రాంతాలు)"
    },
    "amount": 120000,
    "unit": {
      "en": "one time",
      "hi": "एकमुश्त",
      "te": "ఒకేసారి"
    },
    "source": {
      "doc": "pmay_g.md",
      "page": 2,
      "quote": "Assistance of ₹1,20,000 in plain areas and ₹1,30,000 in hilly and difficult areas for building a house."
    }
  },
  "documents_required": [
    "aadhaar",
    "job_card",
    "bank_passbook"
  ],
