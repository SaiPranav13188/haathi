  "benefit": {
    "summary": {
      "en": "Premium only 2% (Kharif), 1.5% (Rabi), 5% (commercial)",
      "hi": "प्रीमियम सिर्फ़ 2% (खरीफ़), 1.5% (रबी), 5% (वाणिज्यिक)",
      "te": "ప్రీమియం కేవలం 2% (ఖరీఫ్), 1.5% (రబీ), 5% (వాణిజ్య)"
    },
    "amount": null,
    "unit": null,
    "source": {
      "doc": "pmfby.md",
      "page": 2,
      "quote": "The farmer pays a maximum premium of 2% of the sum insured for Kharif crops, 1.5% for Rabi crops and 5% for commercial and horticultural crops."
    }
  },
