  "rules": [
    {
      "id": "r1",
      "field": "age",
      "op": "gte",
      "value": 57,
      "source": {
        "doc": "ts_aasara_pension.md",
        "page": 1,
        "quote": "Old age pension is given to persons who have completed 57 years of age and reside in Telangana."
      }
    },
    {
      "id": "r2",
      "field": "state",
      "op": "eq",
      "value": "Telangana",
      "source": {
        "doc": "ts_aasara_pension.md",
        "page": 1,
        "quote": "Old age pension is given to persons who have completed 57 years of age and reside in Telangana."
      }
    },
    {
      "id": "r3",
      "field": "area",
      "op": "eq",
      "value": "rural",
      "source": {
        "doc": "ts_aasara_pension.md",
        "page": 1,
        "quote": "The annual family income should not exceed ₹1,50,000 in rural areas."
      }
    },
    {
      "id": "r4",
      "field": "annual_income",
      "op": "lte",
      "value": 150000,
      "source": {
        "doc": "ts_aasara_pension.md",
        "page": 1,
        "quote": "The annual family income should not exceed ₹1,50,000 in rural areas."
      }
    },
    {
      "id": "r5",
      "field": "area",
      "op": "eq",
      "value": "urban",
      "source": {
        "doc": "ts_aasara_pension.md",
        "page": 1,
        "quote": "The annual family income should not exceed ₹2,00,000 in urban areas."
      }
    },
    {
      "id": "r6",
      "field": "annual_income",
      "op": "lte",
      "value": 200000,
      "source": {
        "doc": "ts_aasara_pension.md",
        "page": 1,
        "quote": "The annual family income should not exceed ₹2,00,000 in urban areas."
      }
    },
    {
      "id": "r7",
      "field": "is_govt_employee",
      "op": "eq",
      "value": false,
      "source": {
        "doc": "ts_aasara_pension.md",
        "page": 1,
        "quote": "Persons who are government employees or pensioners are not eligible."
      }
    }
  ],
  "logic": "r1 AND r2 AND r7 AND ((r3 AND r4) OR (r5 AND r6))",
